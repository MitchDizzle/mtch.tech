---
layout: layouts/shell.njk
title: false
description: Mitchtopia — the personal site of Mitch Gardner. Software, motorcycles, baking, and games.
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  <div class="title-card">
    <h1 class="title-card__name">Mitchtopia</h1>
    <p class="title-card__sub">Mitch Gardner</p>
  </div>

  {% call panel({ variant: "prompt", label: "Choose how to view this site" }) %}
    <p class="muted">
      Software engineer of ten years. Motorcycles, baking, and games in
      between. Pick how you would like to look around.
    </p>
    <div class="panel__actions">
      <a class="btn btn--stack" href="/site/" data-panel-exit>
        Simplified
        <span class="btn__hint">More about Mitch</span>
      </a>
      <a class="btn btn--stack" href="/play/" data-panel-exit>
        Interactive
        <span class="btn__hint">Rougelike Game</span>
      </a>
    </div>
  {% endcall %}
</main>
