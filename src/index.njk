---
layout: layouts/shell.njk
title: false
description: Mitchtopia - the personal site of Mitch Gardner. Software, motorcycles, baking, and games.
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  {# The wordmark is Breathe Fire III, converted to outlines.

     It is NOT loaded as a webfont: the licence is non-commercial and an
     @font-face rule would distribute the font binary to every visitor.
     Outlines ship no font file, and cost one small request instead.

     Drop the exported file at src/assets/img/mitchtopia.svg and it is used
     automatically; until then the styled text below stands in. #}
  <div class="title-card">
    {% set wordmark = "/assets/img/mitchtopia.svg" %}
    {% if wordmark | hasAsset %}
    <h1 class="title-card__name title-card__name--art">
      <img src="{{ wordmark | bust }}" alt="Mitchtopia" width="640" height="140">
    </h1>
    {% else %}
    <h1 class="title-card__name">Mitchtopia</h1>
    {% endif %}
    <p class="title-card__sub">Mitch Gardner</p>
  </div>

  {# Choice panel. "Interactive" swaps to the options panel in place rather
     than navigating - it is a step in a flow, not a destination. #}
  {% call panel({ id: "choose", variant: "prompt", class: "is-intro", label: "Choose how to view this site" }) %}
    <p class="muted">
      Software engineer of ten years. Motorcycles, baking, and games in
      between. Pick how you would like to look around.
    </p>
    <div class="panel__actions">
      <a class="btn btn--stack" href="/site/" data-panel-exit>
        Simplified
        <span class="btn__hint">More about Mitch</span>
      </a>
      <a class="btn btn--stack" href="/play/" data-panel-to="options">
        Interactive
        <span class="btn__hint">Rougelike Game</span>
      </a>
    </div>
  {% endcall %}

  {# Confirmation before the game loads. Hidden until swapped in; the href on
     the trigger above still points at /play/ so JS-off and middle-click work. #}
  {% call panel({
    id: "options",
    variant: "dialog",
    title: "Options",
    labelledBy: "options-title",
    autoOpen: false,
    hidden: true,
    overlay: true
  }) %}
    <p class="muted small">
      Set these before you start. You can change them later from the pause
      menu.
    </p>

    <form id="options-form" method="get" action="/play/">
      <div class="field">
        <label class="field__label" for="vol-music">
          <span>Music</span>
          <span class="field__value" id="vol-music-out">20%</span>
        </label>
        <input type="range" id="vol-music" name="music"
               min="0" max="100" step="1" value="20">
      </div>

      <div class="field">
        <label class="field__label" for="vol-sfx">
          <span>Sound effects</span>
          <span class="field__value" id="vol-sfx-out">40%</span>
        </label>
        <input type="range" id="vol-sfx" name="sfx"
               min="0" max="100" step="1" value="40">
      </div>

      <label class="field field--check">
        <input type="checkbox" id="opt-storage" name="storage" checked>
        <span>
          Save my settings, hats, and best scores in this browser.
          <span class="muted small">No account, nothing leaves your device.</span>
        </span>
      </label>

      <div class="panel__actions">
        <button class="btn" type="button" data-panel-dismiss>Cancel</button>
        <button class="btn" type="submit">Accept and continue</button>
      </div>
    </form>
  {% endcall %}
</main>

<script>
  (function () {
    ["music", "sfx"].forEach(function (k) {
      var input = document.getElementById("vol-" + k);
      var out = document.getElementById("vol-" + k + "-out");
      if (!input || !out) return;
      input.addEventListener("input", function () {
        out.textContent = Math.round(input.value) + "%";
      });
    });

    /* The game route is a placeholder. Persist the choices and show the
       LitRPG toast so the flow is demonstrable end to end. */
    var form = document.getElementById("options-form");
    if (!form) return;

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var settings = {
        music: Math.round(document.getElementById("vol-music").value),
        sfx: Math.round(document.getElementById("vol-sfx").value),
        storage: document.getElementById("opt-storage").checked
      };
      if (settings.storage) {
        try {
          localStorage.setItem("mitchtopia.settings", JSON.stringify(settings));
        } catch (err) {
          /* Storage disabled or full. Play proceeds without persistence. */
        }
      }
      window.MitchPanel.toast(
        "Settings saved",
        "Music " + settings.music + "%, SFX " + settings.sfx +
          "% - the game is not built yet.",
        { banner: "Notice", tone: "notice"}
      );
    });
  })();
</script>
