{% set projectCategory = item.data.category | projectCategory(item.data.tags) %}
<article class="card" data-category="{{ projectCategory | escape }}" data-search="{{ (item.data.title + ' ' + (item.data.description or '') + ' ' + projectCategory + ' ' + (item.data.tags | default([]) | join(' ')) + ' ' + (item.data.keywords | default([]) | join(' '))) | escape }}">
  {% if item.data.image %}
  <img class="card-img" src="{{ item.data.image }}" alt="" loading="lazy">
  {% endif %}
  <div class="card-body">
    {# The title link is stretched over the whole card in CSS, so the card is
       clickable without nesting interactive elements or duplicating the link. #}
    <h3 class="card-title"><a href="{{ item.url }}">{{ item.data.title }}</a></h3>

    {% if item.data.description %}
    <p class="card-desc">{{ item.data.description }}</p>
    {% endif %}

    <ul class="tag-list">
      <li class="tag">{{ projectCategory | escape }}</li>
    </ul>

    {% if item.data.github_url or item.data.live_url %}
    <div class="card-actions">
      {% if item.data.github_url %}
      <a class="btn btn--sm" href="{{ item.data.github_url }}" rel="noopener">Code</a>
      {% endif %}
      {% if item.data.live_url %}
      <a class="btn btn--sm" href="{{ item.data.live_url }}" rel="noopener">Live</a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</article>
