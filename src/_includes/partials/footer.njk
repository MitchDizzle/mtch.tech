{# Legacy footer for pages still on layouts/base.njk (currently just /blog/).
   Reads from site.profiles like the new footer so links stay in one place. #}
{% set repo = site.profiles | findBy("id", "repo") %}
<footer>
  <p>© {{ site.year }} {{ site.name }}</p>
  <p>
    <a href="{{ repo.url }}" rel="noopener">GitHub</a>
  </p>
</footer>
