---
layout: layouts/base.njk
---
<main class="content">
  <article class="project-detail">
    {% if image %}
    <img class="detail-banner" src="{{ image }}" alt="{{ title }}">
    {% endif %}

    <h1>{{ title }}</h1>

    <div class="post-meta">
      {% if tags %}
      <ul class="tag-list">
        {% for tag in tags %}
        <li class="tag">{{ tag }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="detail-links">
        {% if github_url %}
        <a class="btn btn-outline btn-sm" href="{{ github_url }}" target="_blank" rel="noopener">GitHub</a>
        {% endif %}
        {% if live_url %}
        <a class="btn btn-sm" href="{{ live_url }}" target="_blank" rel="noopener">Live Site</a>
        {% endif %}
      </div>
    </div>

    <div class="post-body">
      {{ content | safe }}
    </div>

    <p class="back-link"><a href="/projects/">&larr; Back to Projects</a></p>
  </article>
</main>
