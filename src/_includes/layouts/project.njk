---
layout: layouts/shell.njk
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  {% call panel({
    variant: "page",
    title: title,
    subtitle: date | readableDate,
    labelledBy: "project-title",
    tabs: nav,
    currentUrl: "/projects/"
  }) %}
    <article class="prose project-prose">
      {% if gallery and gallery.length %}
      {% include "partials/project-gallery.njk" %}
      {% elif image %}
      <figure class="project-figure">
        <img src="{{ image | escape }}" alt="{{ imageAlt | default('') | escape }}" decoding="async">
        {% if imageCaption %}<figcaption>{{ imageCaption | escape }}</figcaption>{% endif %}
      </figure>
      {% endif %}

      <ul class="tag-list">
        <li class="tag">{{ category | projectCategory(tags) | escape }}</li>
      </ul>

      {{ content | safe }}

      {% if github_url or live_url %}
      <div class="panel__actions">
        {% if github_url %}
        <a class="btn" href="{{ github_url }}" rel="noopener">View code</a>
        {% endif %}
        {% if live_url %}
        <a class="btn" href="{{ live_url }}" rel="noopener">Visit site</a>
        {% endif %}
      </div>
      {% endif %}
    </article>
  {% endcall %}
</main>
{% if gallery and gallery.length > 1 %}
<script src="{{ '/assets/js/project-gallery.js' | bust }}" defer></script>
{% endif %}
