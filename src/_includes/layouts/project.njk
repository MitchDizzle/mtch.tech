---
layout: layouts/shell.njk
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  {% call panel({
    variant: "page",
    title: title,
    labelledBy: "project-title",
    tabs: nav,
    currentUrl: "/projects/"
  }) %}
    <article class="prose project-prose">
      {% set galleryMarkup %}{% if gallery and gallery.length %}{% include "partials/project-gallery.njk" %}{% endif %}{% endset %}
      {{ content | replace('<div data-project-gallery-placeholder></div>', galleryMarkup) | safe }}

      {% if github_url or live_url %}
      <div class="panel__actions">
        {% if github_url %}
        <a class="btn" href="{{ github_url }}" rel="noopener">View code</a>
        {% endif %}
        {% if live_url %}
        <a class="btn" href="{{ live_url }}" rel="noopener">Visit site</a>
        {% endif %}
      </div>
      {% endif %}
      <footer class="project-meta" aria-label="Article details">
        <span>Published <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time></span>
        <span>Category: {{ category | projectCategory(tags) | escape }}</span>
      </footer>
    </article>
  {% endcall %}
</main>
{% if gallery and gallery.length > 1 and 'data-project-gallery-placeholder' in content %}
<script src="{{ '/assets/js/project-gallery.js' | bust }}" defer></script>
{% endif %}
