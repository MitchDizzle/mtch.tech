---
layout: layouts/shell.njk
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  {% call panel({
    variant: "page",
    title: title,
    subtitle: date | readableDate,
    labelledBy: "project-title",
    tabs: nav,
    currentUrl: "/projects/"
  }) %}
    <article class="prose">
      {% if image %}
      <img class="card-img" src="{{ image }}" alt="" style="border-radius:3px">
      {% endif %}

      {% if tags %}
      <ul class="tag-list">
        {% for tag in tags %}
        <li class="tag">{{ tag }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {{ content | safe }}

      {% if github_url or live_url %}
      <div class="panel__actions">
        {% if github_url %}
        <a class="btn" href="{{ github_url }}" rel="noopener">View code</a>
        {% endif %}
        {% if live_url %}
        <a class="btn" href="{{ live_url }}" rel="noopener">Visit site</a>
        {% endif %}
      </div>
      {% endif %}
    </article>
  {% endcall %}
</main>
