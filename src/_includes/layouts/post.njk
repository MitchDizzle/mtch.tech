---
layout: layouts/base.njk
---
<main class="content">
  <article class="post-detail">
    {% if image %}
    <img class="detail-banner" src="{{ image }}" alt="{{ title }}">
    {% endif %}

    <h1>{{ title }}</h1>

    <div class="post-meta">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
      {% if tags %}
      <ul class="tag-list">
        {% for tag in tags %}
        <li class="tag">{{ tag }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    <div class="post-body">
      {{ content | safe }}
    </div>

    <p class="back-link"><a href="/blog/">&larr; Back to Blog</a></p>
  </article>
</main>
