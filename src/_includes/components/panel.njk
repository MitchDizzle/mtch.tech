{# =========================================================================
   Panel macro

   Usage - wrap content with {% call %} so the body is arbitrary markup:

     {% from "components/panel.njk" import panel %}

     {% call panel({ variant: "prompt", title: "Mitchtopia" }) %}
       <p>Software engineer. Motorcycles, baking, and games in between.</p>
       <div class="panel__actions">
         <a class="btn" href="/site/" data-panel-exit>Static site</a>
         <a class="btn" href="/play/" data-panel-exit>Play game</a>
       </div>
     {% endcall %}

   Options:
     variant   prompt | dialog | page | dialogue | toast   (default: prompt)
     banner    LitRPG flavour line naming the KIND of message - "Warning!",
               "Notice", "Quest complete". Distinct from title, which names
               the message itself. Either, both, or neither.
     tone      notice | warning | danger | success | quest
               Retints accent, surface, and border together. Decoration only -
               the banner text must also say what happened, since colour is
               not available to every reader.
     bannerStyle  bar (default, full-width strip) | plaque (centred label)
     title     header text in its own region at the top of the panel - the
               "Options" slot. Also the page title on static pages and the
               speaker name in game dialogue.
     subtitle  flavour line under the title - a speaker's role, a descriptor
     id        element id, needed if you drive it from JS
     tabs      array of { label, href } or { label, pane } - omit for none
     autoOpen  false to leave it closed until JS opens it (default: true)
     hidden    true to render with the hidden attribute, for panels that are
               swapped in later via data-panel-to
     overlay   true to wrap in a fixed, scrimmed overlay so the panel covers
               the page instead of pushing siblings around
     class     extra classes
     labelledBy / label  accessible name when there is no visible title
   ========================================================================= #}

{% macro panel(opts = {}) %}
{% set variant = opts.variant | default("prompt") %}
{% if opts.overlay %}<div class="panel-overlay" data-panel-overlay{% if opts.hidden %} hidden{% endif %}>{% endif %}
<div
  class="panel panel--{{ variant }}{% if opts.tone %} panel--{{ opts.tone }}{% endif %}{% if opts.banner %} panel--banner-{{ opts.bannerStyle | default("bar") }}{% endif %}{% if opts.class %} {{ opts.class }}{% endif %}"
  {% if opts.id %}id="{{ opts.id }}"{% endif %}
  data-panel
  {# When wrapped in an overlay the wrapper carries `hidden`, not the panel. #}
  {% if opts.hidden and not opts.overlay %}hidden{% endif %}
  {% if opts.autoOpen === false %}data-panel-no-autoopen{% endif %}
  {% if variant == "dialog" %}role="dialog" aria-modal="true"{% endif %}
  {% if variant == "toast" %}role="status" aria-live="polite"{% endif %}
  {% if opts.labelledBy %}aria-labelledby="{{ opts.labelledBy }}"
  {% elif opts.label %}aria-label="{{ opts.label }}"{% endif %}
>
  <span class="panel__edge" aria-hidden="true"></span>

  {# The banner is real content, not decoration - it is often the only thing
     stating that something is a warning. Left readable, never aria-hidden. #}
  {% if opts.banner %}
  <p class="panel__banner"{% if opts.id %} id="{{ opts.id }}-banner"{% endif %}>{{ opts.banner }}</p>
  {% endif %}

  {% if opts.title or opts.tabs %}
  <div class="panel__header{% if opts.tabs %} panel__header--nav{% endif %}">
    {% if opts.title %}
    <div class="panel__heading">
      <h2 class="panel__title"{% if opts.labelledBy %} id="{{ opts.labelledBy }}"{% endif %}>{{ opts.title }}</h2>
      {% if opts.subtitle %}<p class="panel__subtitle">{{ opts.subtitle }}</p>{% endif %}
    </div>
    {% endif %}

    {% if opts.tabs %}
    {# Site navigation, not an ARIA tablist. These are links to other
       documents; role="tab" would promise in-page panel switching that does
       not happen and would mislead screen reader users. #}
    <nav class="panel__tabs" aria-label="{{ opts.tabsLabel | default('Sections') }}">
      {% for tab in opts.tabs %}
        {# Pass currentUrl: page.url and the active tab marks itself. Doing it
           per-page by hand means every new page is one forgotten flag away
           from highlighting the wrong section. #}
        {% set isCurrent = tab.current or (opts.currentUrl and tab.href == opts.currentUrl) %}
        {% if tab.href %}
      <a class="panel__tab{% if isCurrent %} is-current{% endif %}"
         href="{{ tab.href }}"
         {% if isCurrent %}aria-current="page"{% endif %}
         title="{{ tab.label }}">
        {% if tab.icon %}<svg class="panel__tab-icon" aria-hidden="true"><use href="#i-{{ tab.icon }}"/></svg>{% endif %}
        <span class="panel__tab-label{% if tab.icon %} sr-only{% endif %}">{{ tab.label }}</span>
      </a>
        {% else %}
      <button class="panel__tab" type="button" role="tab"
              id="tab-{{ tab.pane }}"
              aria-controls="{{ tab.pane }}"
              aria-selected="{{ 'true' if loop.first else 'false' }}"
              tabindex="{{ '0' if loop.first else '-1' }}">
        {% if tab.icon %}<svg class="panel__tab-icon" aria-hidden="true"><use href="#i-{{ tab.icon }}"/></svg>{% endif %}
        <span class="panel__tab-label{% if tab.icon %} sr-only{% endif %}">{{ tab.label }}</span>
      </button>
        {% endif %}
      {% endfor %}
    </nav>
    {% endif %}
  </div>
  {% endif %}

  <div class="panel__body">
    {{ caller() }}
  </div>
</div>
{% if opts.overlay %}</div>{% endif %}
{% endmacro %}


{# =========================================================================
   Toast container. Include once per page that fires notifications.
   ========================================================================= #}

{% macro toastRegion() %}
<div class="panel-toasts" id="panel-toasts" aria-live="polite" aria-atomic="false"></div>
{% endmacro %}
