---
layout: layouts/shell.njk
permalink: /projects/
title: Projects
description: Personal and professional projects - infrastructure, tooling, and software.
---
{% from "components/panel.njk" import panel %}

<main class="landing">
  {% call panel({
    variant: "page",
    title: "Projects",
    labelledBy: "projects-title",
    tabs: nav,
    currentUrl: page.url
  }) %}
    <p class="section-lead">
      Personal and professional work spanning infrastructure, tooling, and
      whatever else seemed worth building.
    </p>

    {% if collections.projects | length %}
    <div class="project-tools" data-project-tools hidden>
    <label class="project-search" for="project-search">Search projects
      <input id="project-search" type="search" placeholder="Title or keyword" aria-controls="card-grid">
    </label>
    <div class="filter-bar" role="group" aria-label="Filter projects by category">
      <button class="filter-btn active" type="button" data-category-filter="" aria-pressed="true">All</button>
      {% for category in collections.projects | projectCategories %}
      <button class="filter-btn" type="button" data-category-filter="{{ category | escape }}" aria-pressed="false">{{ category | escape }}</button>
      {% endfor %}
    </div>
    <p class="project-results" data-project-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <div class="card-grid" id="card-grid">
      {% for item in collections.projects %}
        {% include "partials/project-card.njk" %}
      {% endfor %}
    </div>
    <p class="empty" data-project-empty hidden>No matching projects. Try another search or choose All.</p>
    {% else %}
    <p class="empty">No projects yet.</p>
    {% endif %}
  {% endcall %}
</main>

<script src="{{ '/assets/js/project-search.js' | bust }}" defer></script>
